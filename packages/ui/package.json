{
  "name": "vueduck-ui",
  "version": "0.0.0",
  "description": "Vue 3 & Nuxt component library",
  "type": "module",
  "license": "MIT",
  "author": "billy7175",
  "homepage": "https://github.com/billy7175/vueduck-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billy7175/vueduck-ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/billy7175/vueduck-ui/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "ui",
    "components",
    "component-library"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": ">=3.4.0",
    "@nuxt/kit": ">=3.0.0",
    "@nuxt/schema": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "@nuxt/schema": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/kit": "^4.5.2",
    "@nuxt/schema": "^4.5.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.1",
    "typescript": "~5.9.0",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.2",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
